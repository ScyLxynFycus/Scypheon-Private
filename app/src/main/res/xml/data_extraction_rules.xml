<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Prevent massive models and sensitive DBs from hitting Google Drive limits -->
        <exclude domain="database" path="scypheon_db"/>
        <exclude domain="file" path="models/"/>
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device transfer can include local config but not the DB -->
        <exclude domain="database" path="scypheon_db"/>
    </device-transfer>
</data-extraction-rules>
